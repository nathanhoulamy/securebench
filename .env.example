# Copy this file to .env and fill in the values you need.
# Do not commit .env.

# API-key mode (the default for both named harnesses).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Claude Code subscription mode: generate with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=

# Codex subscription mode does not use .env. Run:
# .venv/bin/python -m securebench.cli auth codex login
